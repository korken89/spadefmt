impl Thing {
    fn one(self) -> bool {
        true
    }

    fn two(self) -> bool {
        false
    }
    fn three(self) -> bool {
        true
    }
}

trait Behavior {
    fn one(self) -> bool;
    fn two(self) -> bool;

    fn three(self) -> bool;
}

impl TightTypes {
    type A = bool;
    type B = bool;
    fn one(self) -> bool {
        true
    }
}

impl SpacedTypes {
    type A = bool;

    type B = bool;

    fn one(self) -> bool {
        true
    }
}

trait TightAssoc {
    type A;
    type B;
    fn one(self) -> bool;
}

trait SpacedAssoc {
    type A;

    type B;

    fn one(self) -> bool;
}
